# Example environment for local / cluster lab use (do not commit real secrets).
# VLLM_IMAGE must be digest-pinned when using admit/serve
# VLLM_IMAGE=vllm/vllm-openai@sha256:<64hex>
# DGX_LAB_API_TOKEN=  # generated by ./scripts/phase1 init into $DGX_LAB_ROOT/.api_token
# HF_TOKEN=           # only if Hugging Face requires auth
# DGX_LAB_ROOT=~/dgx-lab
# DGX_LAB_OPERATOR=your-name
# BASE_URL=http://127.0.0.1:8000
# For cluster evals: BASE_URL=https://your-cluster.example/v1
# ALLOW_NON_LOOPBACK_BIND=0
# ALLOW_REMOTE_SMOKE=0
# SERVE_BIND_HOST=127.0.0.1
# SERVE_PORT=8000
# CANDIDATE_CFG=configs/runtime-candidates/qwen3-8b-spark.yaml
