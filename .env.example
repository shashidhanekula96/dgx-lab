# Example environment for dgx-lab. Copy to .env (git-ignored) or export in your shell.
# Never commit real tokens.

# --- Connecting to an endpoint ------------------------------------------------
# DGX_LAB_BASE_URL=http://127.0.0.1:8000          # local (with or without /v1)
# DGX_LAB_BASE_URL=https://your-gateway.example/v1  # remote must be https
# DGX_LAB_API_TOKEN=                               # bearer token (omit + use --no-auth for local Ollama/LM Studio)

# --- Run records -----------------------------------------------------------------
# DGX_LAB_ROOT=~/dgx-lab
# DGX_LAB_OPERATOR=your-name
# DGX_LAB_DEBUG=0                                  # 1 = full tracebacks

# --- Optional GPU serve via ./scripts/phase1 ---------------------------------------
# VLLM_IMAGE=vllm/vllm-openai@sha256:<64hex>       # digest pin required for admit/serve
# HF_TOKEN=                                        # only if the Hugging Face repo is gated
# BASE_URL=http://127.0.0.1:8000                   # used by phase1 smoke/run-baseline
# ALLOW_NON_LOOPBACK_BIND=0
# ALLOW_REMOTE_SMOKE=0
# SERVE_BIND_HOST=127.0.0.1
# SERVE_PORT=8000
# CANDIDATE_CFG=configs/runtime-candidates/qwen3-8b-spark.yaml
